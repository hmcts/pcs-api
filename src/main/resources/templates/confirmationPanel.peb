<div class="govuk-panel govuk-panel--confirmation govuk-!-padding-top-3 govuk-!-padding-bottom-3 govuk-!-margin-bottom-6">
  <span class="govuk-panel__title govuk-!-font-size-36">{{ title }}</span>
  {% for bodyLine in bodyLines %}
  <p class="govuk-panel__body govuk-!-font-size-24 govuk-panel--confirmation govuk-!-margin-bottom-1
   {% if loop.first %} govuk-!-margin-top-5 {% endif %}">{{ bodyLine }}</p>
  {% endfor %}
</div>
