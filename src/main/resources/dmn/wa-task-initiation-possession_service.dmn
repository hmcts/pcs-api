      <!-- Enforcement tasks (18-work-allocation-tasks.feature). Enforcement status lives on the
           enforcement record and never changes the case state, so these rules read it from case
           data rather than from postEventState. -->
      <rule id="DecisionRule_enfReviewWarrantApplication">
        <description>An application for a type with no fee goes straight to review on submit. The paid path has no CCD event: EnforcementOrderService#recordFeePaid moves the status, so that path creates the task through CamundaService instead (HDPI-2877).</description>
        <inputEntry id="UnaryTests_enfReviewWarrantApplicationEvent">
          <text>"enforceTheOrder"</text>
        </inputEntry>
