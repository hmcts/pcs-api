<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="wa-initiation-definition" name="DRD" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <decision id="wa-task-initiation-pcs-pcs" name="Task initiation DMN" camunda:historyTimeToLive="P90D">
    <decisionTable id="DecisionTable_0jtevuc" hitPolicy="COLLECT">
      <input id="Input_1" label="Event Id" camunda:inputVariable="eventId">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <input id="InputClause_0gxli97" label="Post event state" biodi:width="268" camunda:inputVariable="postEventState">
        <inputExpression id="LiteralExpression_0dijl5x" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <input id="InputClause_enfStatus" label="Enforcement status" biodi:width="250" camunda:inputVariable="enforcementStatus">
        <inputExpression id="LiteralExpression_enfStatus" typeRef="string">
          <text>if(additionalData != null and additionalData.Data != null and additionalData.Data.enforcementStatus != null)
            then additionalData.Data.enforcementStatus
            else null</text>
        </inputExpression>
      </input>
      <input id="InputClause_enfNoticeToServe" label="Notice of eviction still to serve" biodi:width="250" camunda:inputVariable="canMarkNoticeOfEvictionServed">
        <inputExpression id="LiteralExpression_enfNoticeToServe" typeRef="string">
          <text>if(additionalData != null and additionalData.Data != null
            and additionalData.Data.canMarkNoticeOfEvictionServed != null)
            then additionalData.Data.canMarkNoticeOfEvictionServed
            else null</text>
        </inputExpression>
      </input>
      <input id="InputClause_18rl6x4" label="Counterclaim state">
        <inputExpression id="LiteralExpression_0y39cf1" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <input id="InputClause_0xei6sq" label="Gen app state">
        <inputExpression id="LiteralExpression_113ja6q" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <input id="InputClause_0f5dq2y">
        <inputExpression id="LiteralExpression_177behe" typeRef="string">
          <text></text>
        </inputExpression>
      </input>
      <input id="InputClause_113rn1o" label="Admin Action Required" camunda:inputVariable="adminActionRequired">
        <inputExpression id="LiteralExpression_0uwx76l" typeRef="boolean">
          <text>if(additionalData != null and additionalData.Data != null and additionalData.Data.cicCaseAdminActionRequired
            != null and additionalData.Data.cicCaseAdminActionRequired = ["AdminActionRequired"]) then
            true
else
            false</text>
        </inputExpression>
      </input>
      <input id="InputClause_11t6k59" label="Has Order Due Date" camunda:inputVariable="firstOrderDueDate">
        <inputExpression id="LiteralExpression_1ylfo9b" typeRef="boolean">
          <text>if(additionalData.Data.cicCaseFirstOrderDueDate != null and additionalData.Data.cicCaseFirstOrderDueDate != "") then
  true
else
  false</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Task Id" name="taskId" typeRef="string" biodi:width="320" />
      <output id="OutputClause_0p5fhhd" label="Task Name" name="name" typeRef="string" biodi:width="362" />
      <output id="OutputClause_165p3r3" label="Delay Until" name="delayUntil" typeRef="json" biodi:width="507" />
      <output id="OutputClause_0i6c6c2" label="Working Days Allowed" name="workingDaysAllowed" typeRef="integer" />
      <output id="OutputClause_10rno4c" label="Process Categories Identifiers" name="processCategories" typeRef="string" biodi:width="300" />
      <output id="OutputClause_1wziqr5" label="Work Type" name="workType" typeRef="string" />
      <output id="OutputClause_09b12hk" label="Role Category" name="roleCategory" typeRef="string" />
