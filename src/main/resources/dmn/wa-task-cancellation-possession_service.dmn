<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:biodi="http://bpmn.io/schema/dmn/biodi/2.0" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="wa-cancellation-definition" name="DRD" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <decision id="wa-task-cancellation-pcs-pcs" name="Task cancellation DMN" camunda:historyTimeToLive="P90D">
    <decisionTable id="DecisionTable_0z3jx1g" hitPolicy="COLLECT">
      <input id="Input_1" label="From State">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text>fromState</text>
        </inputExpression>
      </input>
      <input id="InputClause_0ain215" label="Event">
        <inputExpression id="LiteralExpression_0h2l2zj" typeRef="string">
          <text>event</text>
        </inputExpression>
      </input>
      <input id="InputClause_0bomy63" label="To State">
        <inputExpression id="LiteralExpression_1g5glfi" typeRef="string">
          <text>state</text>
        </inputExpression>
      </input>
      <input id="InputClause_enfStatus" label="Enforcement Status" biodi:width="250" camunda:inputVariable="enforcementStatus">
        <inputExpression id="LiteralExpression_enfStatus" typeRef="string">
          <text>if(additionalData != null and additionalData.Data != null and additionalData.Data.enforcementStatus != null)
            then additionalData.Data.enforcementStatus
            else null</text>
        </inputExpression>
      </input>
      <output id="OutputClause_18zgoaj" label="Action" name="action" typeRef="string" />
      <output id="OutputClause_0tu8bqp" label="Task Id" name="Task Id" typeRef="string" />
      <output id="OutputClause_1kfc3jv" label="Warning Text" name="warningText" typeRef="string" />
      <output id="OutputClause_0dqzted" label="Process Categories Identifiers" name="processCategories" typeRef="string" biodi:width="277" />
      <rule id="DecisionRule_1guzypv">
        <description></description>
        <inputEntry id="UnaryTests_1n3g5ie">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_1g1cc7g">
          <text>"changeCaseState"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1ah5t17">
          <text>"CASE_CLOSED"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfStatusCaseClosed">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1c4vo81">
          <text>"Cancel"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0mfk4dd">
          <text>"NewClaimCreateNewHearing"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1xi8ame">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_038kekv">
          <text>"NewClaimCreateNewHearing"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1odfrdp">
        <inputEntry id="UnaryTests_1yv0lj6">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_1iy8xdd">
          <text>"changeCaseState"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_0bv4k05">
          <text>"CASE_STAYED"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfStatusCaseStayed">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_08a36m9">
          <text>"Cancel"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0dkpwml">
          <text>"NewClaimCreateNewHearing"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1wcfw43">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_05fdkyt">
          <text>"NewClaimCreateNewHearing"</text>
        </outputEntry>
      </rule>
      <!-- A return cancels the bailiff tasks the new enforcement status makes obsolete
           (11-record-warrant-return.feature, HDPI-8189). One rule per process category: several
           categories in one rule would only cancel tasks carrying all of them. A return to
           AWAITING_SCHEDULING or BREATHING_SPACE voids the eviction date, so the tasks that hang off it
           go; a return to AWAITING_BAILIFF_ALLOCATION also ends the allocation, so the allocated
           bailiff's own tasks go too. -->
      <rule id="DecisionRule_enfCancelAllocate">
        <inputEntry id="UnaryTests_enfCancelAllocateFromState">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelAllocateEvent">
          <text>"recordWarrantReturn"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelAllocateToState">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelAllocateStatus">
          <text>"CLOSED"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_enfCancelAllocateAction">
          <text>"Cancel"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelAllocateTaskId">
          <text>"AllocateCaseToBailiff"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelAllocateWarningText">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelAllocateCategories">
          <text>"AllocateCaseToBailiff"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_enfCancelRiskLevel">
        <inputEntry id="UnaryTests_enfCancelRiskLevelFromState">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelRiskLevelEvent">
          <text>"recordWarrantReturn"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelRiskLevelToState">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelRiskLevelStatus">
          <text>"CLOSED", "AWAITING_BAILIFF_ALLOCATION"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_enfCancelRiskLevelAction">
          <text>"Cancel"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelRiskLevelTaskId">
          <text>"ReviewRisksAndSetLevel"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelRiskLevelWarningText">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelRiskLevelCategories">
          <text>"ReviewRisksAndSetLevel"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_enfCancelNoticeServed">
        <inputEntry id="UnaryTests_enfCancelNoticeServedFromState">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelNoticeServedEvent">
          <text>"recordWarrantReturn"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelNoticeServedToState">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelNoticeServedStatus">
          <text>"CLOSED", "AWAITING_SCHEDULING", "BREATHING_SPACE", "AWAITING_BAILIFF_ALLOCATION"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_enfCancelNoticeServedAction">
          <text>"Cancel"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelNoticeServedTaskId">
          <text>"MarkNoticeOfEvictionServed"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelNoticeServedWarningText">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelNoticeServedCategories">
          <text>"MarkNoticeOfEvictionServed"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_enfCancelReschedule">
        <inputEntry id="UnaryTests_enfCancelRescheduleFromState">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelRescheduleEvent">
          <text>"recordWarrantReturn"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelRescheduleToState">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelRescheduleStatus">
          <text>"CLOSED", "AWAITING_SCHEDULING", "BREATHING_SPACE", "AWAITING_BAILIFF_ALLOCATION"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_enfCancelRescheduleAction">
          <text>"Cancel"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelRescheduleTaskId">
          <text>"RescheduleEviction"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelRescheduleWarningText">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelRescheduleCategories">
          <text>"RescheduleEviction"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_enfCancelUpdatedRisk">
        <inputEntry id="UnaryTests_enfCancelUpdatedRiskFromState">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelUpdatedRiskEvent">
          <text>"recordWarrantReturn"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelUpdatedRiskToState">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelUpdatedRiskStatus">
          <text>"CLOSED", "AWAITING_BAILIFF_ALLOCATION"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_enfCancelUpdatedRiskAction">
          <text>"Cancel"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelUpdatedRiskTaskId">
          <text>"ReviewUpdatedRiskInformation"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelUpdatedRiskWarningText">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelUpdatedRiskCategories">
          <text>"ReviewUpdatedRiskInformation"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_enfCancelRecordReturn">
        <inputEntry id="UnaryTests_enfCancelRecordReturnFromState">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelRecordReturnEvent">
          <text>"recordWarrantReturn"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelRecordReturnToState">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelRecordReturnStatus">
          <text>"CLOSED", "AWAITING_SCHEDULING", "BREATHING_SPACE", "AWAITING_BAILIFF_ALLOCATION"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_enfCancelRecordReturnAction">
          <text>"Cancel"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelRecordReturnTaskId">
          <text>"RecordWarrantReturn"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelRecordReturnWarningText">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelRecordReturnCategories">
          <text>"RecordWarrantReturn"</text>
        </outputEntry>
      </rule>
      <!-- A new eviction date needs a new return task due on it, so the one due on the old date goes
           (07-reschedule-eviction.feature, HDPI-7549). -->
      <rule id="DecisionRule_enfCancelRecordReturnOnReschedule">
        <inputEntry id="UnaryTests_enfCancelRecordReturnOnRescheduleFromState">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelRecordReturnOnRescheduleEvent">
          <text>"rescheduleEviction"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelRecordReturnOnRescheduleToState">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfCancelRecordReturnOnRescheduleStatus">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_enfCancelRecordReturnOnRescheduleAction">
          <text>"Cancel"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelRecordReturnOnRescheduleTaskId">
          <text>"RecordWarrantReturn"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelRecordReturnOnRescheduleWarningText">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfCancelRecordReturnOnRescheduleCategories">
          <text>"RecordWarrantReturn"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_11kloew">
        <inputEntry id="UnaryTests_11epwat">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_0o4u5xv">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_0qljs5l">
          <text></text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfStatusCatchAll">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0g5ch6y">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_1rm2l11">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0uym570">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_15w5tw6">
          <text></text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
