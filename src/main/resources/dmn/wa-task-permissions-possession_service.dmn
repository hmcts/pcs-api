      <rule id="DecisionRule_enfAllocatedBailiffTasks">
        <description>allocated-bailiff is the case role AllocateBailiff grants, so these tasks auto-assign to the bailiff the enforcement is allocated to and follow a reallocation</description>
        <inputEntry id="UnaryTests_enfAllocatedBailiffTasksTaskType">
          <text>"ReviewRisksAndSetLevel", "MarkNoticeOfEvictionServed", "RescheduleEviction", "ReviewUpdatedRiskInformation", "RecordWarrantReturn"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfAllocatedBailiffTasksCase">
          <text></text>
        </inputEntry>
        <outputEntry id="LiteralExpression_enfAllocatedBailiffTasksCategory">
