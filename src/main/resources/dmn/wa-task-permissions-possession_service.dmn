      <rule id="DecisionRule_enfBailiffAllocation">
        <description>HDPI-7356: a bailiff, a bailiff administrator or a bailiff manager allocates a warrant. This is the bailiff organisational role, not the allocated-bailiff case role the allocation grants</description>
        <inputEntry id="UnaryTests_enfBailiffAllocationTaskType">
          <text>"AllocateCaseToBailiff"</text>
        </inputEntry>
        <inputEntry id="UnaryTests_enfBailiffAllocationCase">
