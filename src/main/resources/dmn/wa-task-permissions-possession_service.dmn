        </outputEntry>
        <outputEntry id="LiteralExpression_enfAllocatedBailiffTasksRoleCategory">
          <text>"ENFORCEMENT"</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfAllocatedBailiffTasksAuthorisations">
          <text></text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfAllocatedBailiffTasksPriority">
          <text>1</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_enfAllocatedBailiffTasksAutoAssignable">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_enfBailiffTasks">
        <description>A bailiff who can access the case can act on its warrants, so every bailiff can see and claim these tasks; only the allocated bailiff gets one assigned to them</description>
        <inputEntry id="UnaryTests_enfBailiffTasksTaskType">
          <text>"ReviewRisksAndSetLevel", "MarkNoticeOfEvictionServed", "RescheduleEviction", "ReviewUpdatedRiskInformation", "RecordWarrantReturn"</text>
