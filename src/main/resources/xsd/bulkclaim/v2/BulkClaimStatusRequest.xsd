<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="http://hmcts.gov.uk/pcs/bulkclaim/v2"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://hmcts.gov.uk/pcs/bulkclaim/v2"
           elementFormDefault="qualified">
  <xs:include schemaLocation="Common.xsd"/>

  <xs:element name="BulkClaimStatusRequest">
    <xs:annotation>
      <xs:documentation>
        Asks for the status of up to 100 claims in one call. The response lists one entry per identifier, in
        request order. An identifier repeated in the request is answered at each position it appears.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="CustomerUniqueIdentifier" type="CustomerUniqueIdentifierType"
                    minOccurs="1" maxOccurs="100"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
