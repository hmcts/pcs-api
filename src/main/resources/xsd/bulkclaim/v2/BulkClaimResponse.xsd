<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="http://hmcts.gov.uk/pcs/bulkclaim/v2"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://hmcts.gov.uk/pcs/bulkclaim/v2"
           elementFormDefault="qualified">
  <xs:include schemaLocation="Common.xsd"/>

  <xs:complexType name="ValidationErrorType">
    <xs:sequence>
      <xs:element name="Path" type="xs:string"/>
      <xs:element name="Code" type="xs:string"/>
      <xs:element name="Message" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ClaimResponseType">
    <xs:sequence>
      <xs:element name="CustomerUniqueIdentifier" type="xs:string" minOccurs="0"/>
      <xs:element name="ClaimStatus" type="StatusType"/>
      <xs:element name="ClaimNumber" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>The case reference formatted as 1234-5678-9012-3456, present on success.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="CaseReference" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{16}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="ValidationErrors" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ValidationError" type="ValidationErrorType" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="BulkClaimResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="BulkStatus" type="StatusType"/>
        <xs:element name="ClaimResponse" type="ClaimResponseType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
