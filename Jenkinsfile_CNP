#!groovy

@Library("Infrastructure@2.4.9")

import uk.gov.hmcts.contino.AppPipelineConfig
import uk.gov.hmcts.contino.AppPipelineDsl
import uk.gov.hmcts.contino.GithubAPI
import uk.gov.hmcts.contino.GradleBuilder

def type = "java"
def product = "pcs"
def component = "api"

def secrets = [
  'pcs-${env}': [
    secret('pcs-api-s2s-secret', 'PCS_API_S2S_SECRET'),
    secret('idam-system-user-name', 'IDAM_SYSTEM_USERNAME'),
    secret('idam-system-user-password', 'IDAM_SYSTEM_USER_PASSWORD'),
    secret('pcs-api-idam-secret', 'PCS_API_IDAM_SECRET'),
    secret('idam-testing-support-url', 'IDAM_TESTING_SUPPORT_URL'),
    secret('idam-pcs-user-password', 'IDAM_PCS_USER_PASSWORD'),
    secret('pcs-solicitor-automation-uid', 'PCS_SOLICITOR_AUTOMATION_UID'),
    secret('pcs-prd-admin-username', 'PCS_PRD_ADMIN_USERNAME'),
    secret('pcs-prd-admin-password', 'PCS_PRD_ADMIN_PASSWORD'),
    secret('idam-expired-user-token', 'IDAM_EXPIRED_USER_TOKEN'),
    secret('s2s-expired-service-token', 'S2S_EXPIRED_TOKEN'),
    secret('definition-importer-username', 'DEFINITION_IMPORTER_USERNAME'),
    secret('definition-importer-password', 'DEFINITION_IMPORTER_PASSWORD'),
  ]
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [ $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    version: '',
    envVariable: envVar
  ]
}

// Secrets the perftest smoke run needs from the pcs-perftest vault. Deliberately a subset of
// the main `secrets` map: the perftest vault holds no idam-testing-support-url,
// idam-expired-user-token or s2s-expired-service-token, so those are supplied separately in
// runPerftestSmokeTests.
def perftestSmokeSecrets = [
  'pcs-${env}': [
    secret('idam-system-user-name', 'IDAM_SYSTEM_USERNAME'),
    secret('idam-system-user-password', 'IDAM_SYSTEM_USER_PASSWORD'),
    secret('pcs-api-idam-secret', 'PCS_API_IDAM_SECRET'),
    secret('idam-pcs-user-password', 'IDAM_PCS_USER_PASSWORD'),
    secret('pcs-solicitor-automation-uid', 'PCS_SOLICITOR_AUTOMATION_UID'),
  ]
]

GradleBuilder builder = new GradleBuilder(this, product)

// Shutters the PCS case type across all environments (bakes shutterService() into the generated
// CCD definition). While shuttered, cases cannot be created, so the e2e suite is not run.
def shutterService = false

withPipeline(type, product, component) {
  def githubApi = new GithubAPI(this)
  env.IDAM_S2S_AUTH_URL = "http://rpe-service-auth-provider-aat.service.core-compute-aat.internal"
  env.IDAM_API_URL = "https://idam-api.aat.platform.hmcts.net"
  env.PACT_BROKER_URL = "https://pact-broker.platform.hmcts.net"
  loadVaultSecrets(secrets)
  enableDbMigration('pcs')

  //skipping sync with demo/perftest during SIT testing/DB migration
  syncBranchesWithMaster(['ithc', 'perftest', 'demo'])

  // WA DMN/BPMN upload for demo/ithc/perftest. Those branches never run sectionDeployToAKS,
  // so there is no smoketest:/functionalTest: stage to hang this off.
  afterSuccess('checkout') {
    if (env.ENVIRONMENT == 'ithc' || env.ENVIRONMENT == 'demo' || env.ENVIRONMENT == 'perftest') {
      withSubscription('nonprod') {
        uploadDmnDiagrams()
        uploadBpmnDiagram()
      }
    }
  }

  onPR() {
    enablePactAs([
      AppPipelineDsl.PactRoles.CONSUMER,
      AppPipelineDsl.PactRoles.CONSUMER_DEPLOY_CHECK
    ])
    setPreviewEnvVars(githubApi)
    if (githubApi.getLabelsbyPattern(env.BRANCH_NAME, "pr-values:ccd").size() > 0) {
      env.CCD_ENABLED = "true"
      enableHighLevelDataSetup()
    } else {
      env.CCD_ENABLED = "false"
    }
    // Work Allocation preview (pr-values:wa) — WA pods and Camunda
    env.CAMUNDA_BASE_URL = "https://camunda-pcs-api-pr-${CHANGE_ID}.preview.platform.hmcts.net"
    env.TASK_MONITOR_API_URL = "https://wa-task-monitor-pcs-api-pr-${CHANGE_ID}.preview.platform.hmcts.net"
    env.TASK_MANAGEMENT_API_URL = "https://wa-task-management-api-pcs-api-pr-${CHANGE_ID}.preview.platform.hmcts.net"
    def waPRLabels = githubApi.getLabelsbyPattern(env.BRANCH_NAME, "pr-values:wa")
    if (waPRLabels.contains("pr-values:wa-ft-tests")) {
      env.WA_FUNCTIONAL_TESTS_ENABLED = true
    }
    if (githubApi.getLabelsbyPattern(env.BRANCH_NAME, "enable_e2e_full_regression").size() > 0) {
      env.E2E_SUITE = "chrome"
    }
    else if (githubApi.getLabelsbyPattern(env.BRANCH_NAME, "enable_e2e_regression").size() > 0) {
      env.E2E_SUITE = "regression"
    }
    else if (githubApi.getLabelsbyPattern(env.BRANCH_NAME, "enable_e2e_makeAClaim_test").size() > 0) {
      env.E2E_SUITE = "makeAClaim"
    }
    else if (githubApi.getLabelsbyPattern(env.BRANCH_NAME, "enable_e2e_CC_test").size() > 0) {
      env.E2E_SUITE = "commonComponent"
    }
    else if (githubApi.getLabelsbyPattern(env.BRANCH_NAME, "enable_e2e_CM_test").size() > 0) {
      env.E2E_SUITE = "caseManagement"
    }
    else if (githubApi.getLabelsbyPattern(env.BRANCH_NAME, "enable_e2e_NOC_test").size() > 0) {
      env.E2E_SUITE = "noticeOfChange"
    }
  }

  onMaster() {
    enablePactAs([
      AppPipelineDsl.PactRoles.CONSUMER,
      AppPipelineDsl.PactRoles.CONSUMER_DEPLOY_CHECK
    ])
    enableHighLevelDataSetup()
    setAatEnvVars()
    env.CAMUNDA_BASE_URL = "http://camunda-api-aat.service.core-compute-aat.internal"
    // The e2e journeys all create cases, which is blocked while the service is shuttered.
    if (!shutterService) {
      enableE2eTest()
    }
  }

  onDemo {
    setDemoEnvVars()
    enableHighLevelDataSetup()
  }

  onIthc {
    setIthcEnvVars()
    enableHighLevelDataSetup()
  }

  onPerftest {
     setPerftestEnvVars()
     enableHighLevelDataSetup()
  }

  before('highleveldatasetup') {
    env.SHUTTER_SERVICE = shutterService

    onPR{
      env.DEFINITION_STORE_URL_BASE = "https://ccd-definition-store-pcs-api-pr-${CHANGE_ID}.preview.platform.hmcts.net"
      env.CASE_API_URL = "https://pcs-api-pr-${CHANGE_ID}.preview.platform.hmcts.net"
      env.DATA_STORE_URL_BASE="https://ccd-data-store-api-pcs-api-pr-${CHANGE_ID}.preview.platform.hmcts.net"
    }
    onMaster{
      if(env.ENVIRONMENT == "prod") {
        env.SHUTTER_SERVICE = true
        env.DATA_STORE_URL_BASE="http://ccd-data-store-api-prod.service.core-compute-prod.internal"
        env.CASE_API_URL = "https://pcs-api.prod.platform.hmcts.net"
        env.CASE_TYPE_SUFFIX=""
      } else {
        env.DEFINITION_STORE_URL_BASE = "http://ccd-definition-store-api-aat.service.core-compute-aat.internal"
        env.DATA_STORE_URL_BASE="http://ccd-data-store-api-aat.service.core-compute-aat.internal"
        env.CASE_API_URL = "https://pcs-api-staging.aat.platform.hmcts.net"
        env.CASE_TYPE_SUFFIX="staging"
        generateDefinitions(builder)
        env.CASE_API_URL = "http://pcs-api-aat.service.core-compute-aat.internal"
        env.CASE_TYPE_SUFFIX=""
      }
    }
    onPerftest{
      env.DEFINITION_STORE_URL_BASE = "http://ccd-definition-store-api-perftest.service.core-compute-perftest.internal"
      env.CASE_API_URL = "http://pcs-api-perftest.service.core-compute-perftest.internal"
      env.DATA_STORE_URL_BASE="http://ccd-data-store-api-perftest.service.core-compute-perftest.internal"
    }
    onDemo {
      env.DEFINITION_STORE_URL_BASE = "http://ccd-definition-store-api-demo.service.core-compute-demo.internal"
      env.CASE_API_URL = "http://pcs-api-demo.service.core-compute-demo.internal"
      env.DATA_STORE_URL_BASE="http://ccd-data-store-api-demo.service.core-compute-demo.internal"
    }
    onIthc{
      env.DEFINITION_STORE_URL_BASE = "http://ccd-definition-store-api-ithc.service.core-compute-ithc.internal"
      env.CASE_API_URL = "http://pcs-api-ithc.service.core-compute-ithc.internal"
      env.DATA_STORE_URL_BASE="http://ccd-data-store-api-ithc.service.core-compute-ithc.internal"
    }
    generateDefinitions(builder)
  }

  before('smoketest:preview') {
    if (githubApi.getLabelsbyPattern(env.BRANCH_NAME, "pr-values:ccd").size() > 0) {
      sh "./bin/trigger-global-search-index.sh"
    }
  }

  before('smoketest:aat') {
    env.CASE_TYPE_SUFFIX="staging"
    env.CCD_ENABLED = "true"
  }

  // pcs-api is deployed to perftest by flux, not by this pipeline, so the perftest branch
  // goes down onAutoDeployBranch (High Level Data Setup -> Build Infrastructure -> DB
  // Migration) and never reaches sectionDeployToAKS. That means the library never creates a
  // smoketest:perftest stage, never sets TEST_URL (normally derived from helmInstall) and
  // never injects the team secrets (loadVaultSecrets only registers the map; withTeamSecrets
  // is what injects it). So run the smoke suite against the flux-deployed service here,
  // after Flyway has brought the perftest schema up to date. Hooking the environment-suffixed
  // dbmigrate:perftest token means no onPerftest{} guard is needed - unlike the unsuffixed
  // highleveldatasetup token, this only ever fires on the perftest branch.
  afterSuccess('dbmigrate:perftest') {
    runPerftestSmokeTests(builder, perftestSmokeSecrets)
  }

  afterAlways('dbmigrate:perftest') {
    archiveSmokeTestReports()
  }

  afterSuccess('akschartsinstall') {
    onPR {
      if (githubApi.getLabelsbyPattern(env.BRANCH_NAME, "pr-values:wa").size() > 0) {
        env.CAMUNDA_BASE_URL = "https://camunda-pcs-api-pr-${CHANGE_ID}.preview.platform.hmcts.net"
        println """After akschartsinstall upload DMN and BPMN diagrams""".stripIndent()
        uploadDmnDiagrams()
        uploadBpmnDiagram()
      }
    }
  }

  // WA DMN/BPMN deployment for AAT. Unlike preview these always run — WA is part of the
  // AAT/prod topology, not label-gated.
  before('functionalTest:aat') {
    uploadDmnDiagrams()
    uploadBpmnDiagram()
  }

  // Promote the WA Camunda diagrams to prod after AAT functional tests pass.
  afterSuccess('functionalTest:aat') {
    env.ENVIRONMENT = "prod"
    env.CAMUNDA_BASE_URL = "http://camunda-api-prod.service.core-compute-prod.internal"
    uploadDmnDiagrams()
    uploadBpmnDiagram()
  }


  afterAlways('smoketest:preview') {
    archiveSmokeTestReports()
  }

  afterAlways('smoketest:aat') {
    archiveSmokeTestReports()
  }

  afterAlways('functionalTest:preview') {
    archiveFunctionalTestReports()
  }

  afterAlways('functionalTest:aat') {
    archiveFunctionalTestReports()
  }

  afterAlways('E2eTest:aat') {
    if (currentBuild.currentResult in ['FAILURE', 'UNSTABLE']) {
      postAllureResultsToSlack('master')
    }
  }

  afterSuccess('E2eTest:aat') {
    env.ENVIRONMENT= "prod"
  }
}

def setPreviewEnvVars(githubApi) {
  env.MANAGE_CASE_BASE_URL = "https://xui-pcs-api-pr-${CHANGE_ID}.preview.platform.hmcts.net"
  env.ENVIRONMENT= "preview"
  env.ENABLE_TESTING_SUPPORT = "true"
  env.E2E_SUITE= "pr"

  def frontendLabels = githubApi.getLabelsbyPattern(env.BRANCH_NAME, "pcs-frontend-pr:")
  if (frontendLabels && frontendLabels.size() > 0) {
    def labelName = frontendLabels[0]
    def PCS_FRONTEND_CHANGE_ID = labelName.replace("pcs-frontend-pr:", "")
    env.PCS_FRONTEND_URL = "https://pcs-frontend-pr-${PCS_FRONTEND_CHANGE_ID}.preview.platform.hmcts.net"
  } else {
    env.PCS_FRONTEND_URL = "https://pcs.aat.platform.hmcts.net/"
  }
}

