// Runs the Gradle `smoke` task (JUnit tag "Smoke") against the flux-deployed perftest pcs-api.
// This hook runs on the perftest environment agent, so withTeamSecrets reads the vault via
// that agent's managed identity and needs no withSubscription wrapper.
// Uses withEnv rather than env.X = so the perftest IdAM/S2S URLs do not leak into later
// stages - the pipeline sets those globally to aat at the top of withPipeline.
def runPerftestSmokeTests(builder, Map perftestSmokeSecrets) {
  def vaultConfig = new AppPipelineConfig()
  vaultConfig.vaultSecrets = perftestSmokeSecrets

  withTeamSecrets(vaultConfig, 'perftest', 'pcs') {
    withEnv([
      "TEST_URL=http://pcs-api-perftest.service.core-compute-perftest.internal",
      "ENVIRONMENT_NAME=perftest",
      "DATA_STORE_URL_BASE=http://ccd-data-store-api-perftest.service.core-compute-perftest.internal",
      "IDAM_S2S_AUTH_URL=http://rpe-service-auth-provider-perftest.service.core-compute-perftest.internal",
      "IDAM_API_URL=https://idam-api.perftest.platform.hmcts.net",
      // Not held in the perftest vault, but derivable - same slug convention the e2e suite
      // uses in src/e2eTest/config/global-setup.config.ts.
      "IDAM_TESTING_SUPPORT_URL=https://idam-testing-support-api.perftest.platform.hmcts.net",
      // Unused by the Smoke-tagged suite (it never sends an expired token) but TestConstants
      // resolves both in eager static initialisers that throw on a missing var, so they must
      // be set for the class to load. Not in the perftest vault, hence placeholders.
      "IDAM_EXPIRED_USER_TOKEN=unused-on-perftest",
      "S2S_EXPIRED_TOKEN=unused-on-perftest",
      // perftest runs the unsuffixed PCS case type (aat uses PCS-STAGING).
      "CASE_TYPE_SUFFIX="
    ]) {
      echo "Running smoke tests against ${env.TEST_URL}"
      builder.smokeTest()
    }
  }
}

def generateDefinitions(builder) {
  builder.gradle('--rerun-tasks generateCCDConfig')
  sh "./bin/create-xlsx.sh ${env.ENVIRONMENT}"
  steps.archiveArtifacts artifacts: "build/definitions/*.xlsx"
}

def uploadDmnDiagrams() {
  dir("${WORKSPACE}/bin") {
    tenantId = "pcs"
    product = "pcs"
    sh "./wa/import-dmn-diagrams.sh ${WORKSPACE} ${env.ENVIRONMENT} ${tenantId} ${product}"
  }
}

def uploadBpmnDiagram() {
  dir("${WORKSPACE}/bin") {
    bpmnBranch = "master"
    sh """
      ./wa/pull-latest-camunda-wa-files.sh ${bpmnBranch}
      ./wa/import-wa-bpmn-diagram.sh .
    """
  }
}

def archiveFunctionalTestReports() {
  publishHTML([
    allowMissing: true,
    alwaysLinkToLastBuild: true,
    keepAll: true,
    reportDir: "report-for-functional-tests",
    reportFiles: 'index.html',
    reportName: 'API Functional Test Report'
  ])

  archiveArtifacts allowEmptyArchive: true, artifacts: '**/report-for-functional-tests/*'
}

def archiveSmokeTestReports() {
  publishHTML([
    allowMissing: true,
    alwaysLinkToLastBuild: true,
    keepAll: true,
    reportDir: "report-for-smoke-tests",
    reportFiles: 'index.html',
    reportName: 'API Smoke Test Report'
  ])

  archiveArtifacts allowEmptyArchive: true, artifacts: '**/report-for-smoke-tests/*'
}

def archiveE2eTestReports() {
  publishHTML([
    allowMissing: true,
    alwaysLinkToLastBuild: true,
    keepAll: true,
    reportDir: "e2e-output",
    reportFiles: 'index.html',
    reportName: 'E2E Test Report'
  ])

  archiveArtifacts allowEmptyArchive: true, artifacts: '**/e2e-output/**/*'
}

// E2E stage notification to #hdp-qa-e2e-test-results
def postAllureResultsToSlack(String pipelineType = 'master') {
  env.E2E_SERVICE_NAME = 'pcs-api'
  env.E2E_PIPELINE_TYPE = pipelineType
  def msg = sh(
    script: "cd src/e2eTest && E2E_SERVICE_NAME=pcs-api E2E_PIPELINE_TYPE=${pipelineType} ./node_modules/.bin/tsx ./scripts/allure-slack-notifier.ts --print-only || true",
    returnStdout: true
  ).trim()
  if (!msg) {
    msg = "E2E Test Results — Build #${env.BUILD_NUMBER}\n*Service:* pcs-api  |  *Pipeline:* ${pipelineType}\n\nAllure report not available – check build logs.\n*Allure report:* ${env.BUILD_URL}E2E_20Test_20Report/"
  }
  try {
    slackSend(channel: '#hdp-qa-e2e-test-results', message: msg)
    echo "E2E Slack notification sent to #hdp-qa-e2e-test-results"
  } catch (Exception e) {
    echo "WARNING: Failed to send E2E Slack notification: ${e.message}. Check Jenkins Slack plugin and channel access."
  }
}


